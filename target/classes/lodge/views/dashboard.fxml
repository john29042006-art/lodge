<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lodge.controller.DashboardController" styleClass="app-root">
  <top><VBox spacing="0"><HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar"><padding><Insets top="18" right="26" bottom="18" left="26"/></padding><VBox spacing="3"><Label text="HOTELOOK" styleClass="brand-mark"/><Label text="LODGE MANAGEMENT" styleClass="topbar-caption"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox alignment="CENTER_RIGHT" spacing="4"><Label fx:id="welcomeLabel" text="Welcome" styleClass="welcome-label"/><Label fx:id="roleLabel" text="ADMIN ACCESS" styleClass="role-chip"/></VBox><Button text="Log out" onAction="#handleLogout" styleClass="logout-button"/></HBox><HBox styleClass="gold-rule"/></VBox></top>
  <center><VBox spacing="18"><padding><Insets top="22" right="26" bottom="24" left="26"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="4"><Label text="Your lodge at a glance" styleClass="page-title"/><Label text="Keep bookings, payments and room revenue in one place." styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="↻ Refresh" onAction="#handleRefresh" styleClass="secondary-button"/></HBox>
    <GridPane hgap="14" vgap="12"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
      <VBox styleClass="metric-card" GridPane.columnIndex="0"><padding><Insets top="16" right="18" bottom="16" left="18"/></padding><Label text="TOTAL BOOKINGS" styleClass="metric-label"/><Label fx:id="bookingCountLabel" text="0" styleClass="metric-value"/><Label text="All recorded reservations" styleClass="metric-note"/></VBox>
      <VBox styleClass="metric-card" GridPane.columnIndex="1"><padding><Insets top="16" right="18" bottom="16" left="18"/></padding><Label text="CURRENT STAYS" styleClass="metric-label"/><Label fx:id="occupancyLabel" text="0" styleClass="metric-value"/><Label text="Guests currently checked in" styleClass="metric-note"/></VBox>
      <VBox styleClass="metric-card metric-highlight" GridPane.columnIndex="2"><padding><Insets top="16" right="18" bottom="16" left="18"/></padding><Label text="PAYMENTS RECEIVED" styleClass="metric-label"/><Label fx:id="revenueLabel" text="K 0.00" styleClass="metric-value"/><Label text="Cash received to date" styleClass="metric-note"/></VBox>
      <VBox styleClass="metric-card" GridPane.columnIndex="3"><padding><Insets top="16" right="18" bottom="16" left="18"/></padding><Label text="OUTSTANDING" styleClass="metric-label"/><Label fx:id="balanceLabel" text="K 0.00" styleClass="metric-value"/><Label text="Unpaid booking balances" styleClass="metric-note"/></VBox>
    </GridPane>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="main-tabs">
      <Tab fx:id="bookingTab" text="Bookings &amp; Billing"><VBox spacing="14"><padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
        <VBox spacing="12" styleClass="section-card"><Label text="ROOM PRICES · PER NIGHT" styleClass="field-label"/><Label fx:id="allRatesLabel" text="STANDARD K 450.00 / night     •     DELUXE K 750.00 / night     •     FAMILY K 1,100.00 / night" styleClass="rate-list-label" wrapText="true"/><Separator/><Label text="Create a booking" styleClass="section-title"/><GridPane hgap="12" vgap="10"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
          <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="GUEST NAME *" styleClass="field-label"/><TextField fx:id="guestNameField" promptText="Full name"/></VBox>
          <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="PHONE / CONTACT" styleClass="field-label"/><TextField fx:id="phoneField" promptText="Optional"/></VBox>
          <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0"><Label text="ROOM TYPE" styleClass="field-label"/><ComboBox fx:id="roomTypeBox" maxWidth="Infinity"/></VBox>
          <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0"><Label text="ROOM NUMBER *" styleClass="field-label"/><TextField fx:id="roomNumberField" promptText="e.g. 12"/></VBox>
          <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="CHECK-IN" styleClass="field-label"/><DatePicker fx:id="checkInPicker" maxWidth="Infinity"/></VBox>
          <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="CHECK-OUT" styleClass="field-label"/><DatePicker fx:id="checkOutPicker" maxWidth="Infinity"/></VBox>
          <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1"><Label text="ROOM PRICE" styleClass="field-label"/><Label fx:id="rateInfoLabel" text="Standard room · K 450.00 per night" styleClass="price-preview"/></VBox>
          <VBox alignment="BOTTOM_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="1"><Button text="＋ Create booking" onAction="#handleCreateBooking" styleClass="primary-button" maxWidth="Infinity"/></VBox>
        </GridPane><Label fx:id="estimateLabel" text="Estimated bill: K 450.00 for 1 night" styleClass="estimate-label" wrapText="true"/><Label text="Stays of 7 nights or more receive an automatic 5% discount. Room numbers cannot be double-booked for overlapping dates." styleClass="small-muted" wrapText="true"/></VBox>
        <HBox alignment="CENTER_LEFT" spacing="10"><Label text="Booking register" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="searchField" promptText="Search guest, room or ID…" onAction="#handleSearch" maxWidth="260"/><Button text="Search" onAction="#handleSearch" styleClass="secondary-button"/></HBox>
        <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS" styleClass="data-table"><columns>
          <TableColumn fx:id="colId" text="ID" prefWidth="55"/><TableColumn fx:id="colGuest" text="Guest" prefWidth="145"/><TableColumn fx:id="colRoom" text="Room" prefWidth="70"/><TableColumn fx:id="colType" text="Type" prefWidth="90"/><TableColumn fx:id="colIn" text="Check-in" prefWidth="95"/><TableColumn fx:id="colOut" text="Check-out" prefWidth="95"/><TableColumn fx:id="colNights" text="Nights" prefWidth="58"/><TableColumn fx:id="colTotal" text="Total (K)" prefWidth="95"/><TableColumn fx:id="colPaid" text="Paid (K)" prefWidth="90"/><TableColumn fx:id="colBalance" text="Balance (K)" prefWidth="100"/><TableColumn fx:id="colStatus" text="Status" prefWidth="85"/>
        </columns><placeholder><Label text="No bookings yet. Create the first booking above." styleClass="muted-text"/></placeholder></TableView>
        <HBox spacing="10" alignment="CENTER_LEFT"><Button text="View bill" onAction="#handleBill" styleClass="secondary-button"/><Button fx:id="receiptButton" text="Save receipt for selected booking" onAction="#handleReceipt" styleClass="secondary-button"/><Button fx:id="deleteBookingButton" text="Delete selected" onAction="#handleDeleteBooking" styleClass="danger-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="messageLabel" text="Ready." wrapText="true" styleClass="message-success"/></HBox>
      </VBox></Tab>
      <Tab fx:id="paymentTab" text="Record Payment"><VBox spacing="18"><padding><Insets top="22" right="22" bottom="22" left="22"/></padding><Label text="Record a guest payment" styleClass="section-title"/><Label text="Select a booking in the register first, or enter its ID below. Payments update the outstanding balance automatically." styleClass="muted-text" wrapText="true"/><GridPane hgap="14" vgap="12"><columnConstraints><ColumnConstraints minWidth="160"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><Label text="BOOKING ID" styleClass="field-label" GridPane.rowIndex="0"/><TextField fx:id="paymentBookingField" promptText="Booking ID" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="AMOUNT (ZMW)" styleClass="field-label" GridPane.rowIndex="1"/><TextField fx:id="paymentAmountField" promptText="e.g. 500.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="PAYMENT METHOD" styleClass="field-label" GridPane.rowIndex="2"/><ComboBox fx:id="paymentMethodBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/></GridPane><Button fx:id="addPaymentButton" text="＋ Record payment" onAction="#handleAddPayment" styleClass="primary-button"/><Label text="Supported methods: Cash, Mobile Money, Bank Transfer and Card." styleClass="small-muted"/></VBox></Tab>
      <Tab fx:id="ratesTab" text="Room Rates"><VBox spacing="16"><padding><Insets top="22" right="22" bottom="22" left="22"/></padding><Label text="Configure nightly room rates" styleClass="section-title"/><Label text="Rates are stored locally and apply to new bookings. Existing bookings keep their original rate." styleClass="muted-text" wrapText="true"/><GridPane hgap="14" vgap="12"><columnConstraints><ColumnConstraints minWidth="160"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints minWidth="100"/></columnConstraints><Label text="Standard room" styleClass="field-label" GridPane.rowIndex="0"/><TextField fx:id="rateStandardField" promptText="450.00" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="ZMW / night" styleClass="small-muted" GridPane.columnIndex="2" GridPane.rowIndex="0"/><Label text="Deluxe room" styleClass="field-label" GridPane.rowIndex="1"/><TextField fx:id="rateDeluxeField" promptText="750.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="ZMW / night" styleClass="small-muted" GridPane.columnIndex="2" GridPane.rowIndex="1"/><Label text="Family room" styleClass="field-label" GridPane.rowIndex="2"/><TextField fx:id="rateFamilyField" promptText="1100.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Label text="ZMW / night" styleClass="small-muted" GridPane.columnIndex="2" GridPane.rowIndex="2"/></GridPane><Button fx:id="saveRatesButton" text="Save room rates" onAction="#handleSaveRates" styleClass="primary-button"/><Label text="Default rates: Standard K450 · Deluxe K750 · Family K1,100. Weekly stays (7+ nights) receive 5% off." styleClass="small-muted" wrapText="true"/></VBox></Tab>
    </TabPane>
  </VBox></center>
  <bottom><HBox styleClass="footer-bar" alignment="CENTER_LEFT"><padding><Insets top="10" right="26" bottom="10" left="26"/></padding><Label text="HOTELOOK  /  LODGE MANAGEMENT" styleClass="small-muted"/><Region HBox.hgrow="ALWAYS"/><Label text="All amounts in Zambian Kwacha (ZMW)" styleClass="small-muted"/></HBox></bottom>
</BorderPane>
